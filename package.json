{
  "name": "shipshape-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:ci": "jest --ci --forceExit --json --outputFile=reports/test-results.json --coverage",
    "secret-scan": "node scripts/secret-scan.mjs",
    "release-analysis": "node scripts/release-analysis.mjs",
    "policy-check": "node scripts/policy-check.mjs",
    "checks": "npm run lint && npm run type-check && npm run test && npm run secret-scan"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  }
}

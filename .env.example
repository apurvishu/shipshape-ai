# ShipShape AI — Environment Configuration
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local with real values!

# ── Application ──
NEXT_PUBLIC_APP_NAME=ShipShape AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── GitLab Integration (Optional) ──
# These are only needed if you want to fetch live data from GitLab.
# The app works in demo mode without these.
# GITLAB_URL=https://gitlab.com
# GITLAB_PROJECT_ID=your_project_id
# GITLAB_ACCESS_TOKEN=your_access_token_CHANGE_ME

# ── Feature Flags ──
NEXT_PUBLIC_DEMO_MODE=true
